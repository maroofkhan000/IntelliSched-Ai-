MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DB=intellisched
JWT_SECRET=change-me-to-a-long-random-string
# Logins for the admin and feeder accounts (passwords at least 10 characters).
# ADMIN_PASSWORD is also the one asked for before big deletes. Restart after changing.
ADMIN_USERNAME=change-me-admin-username
ADMIN_PASSWORD=change-me-admin-password
FEEDER_USERNAME=change-me-feeder-username
FEEDER_PASSWORD=change-me-feeder-password
PORT=4000
CORS_ORIGIN=http://localhost:5173
